NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI plan generation — set one of these. GROK_API takes priority.
# Groq (recommended): https://console.groq.com/keys
GROK_API=
# OpenAI fallback: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Override the model. Defaults: Groq → llama-4-scout-17b-16e-instruct, OpenAI → gpt-4.1-mini
OPENAI_MODEL=

# WHOOP OAuth. Register {your-site}/api/whoop/callback in the WHOOP developer dashboard.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_TOKEN_SECRET=
# Optional override. Defaults to the request origin plus /api/whoop/callback.
WHOOP_REDIRECT_URI=

# Strava OAuth. Create an app at https://www.strava.com/settings/api
# Set Authorization Callback Domain to your domain (e.g. app.tamreen.ai — no https://, no path).
# The callback route is automatically {your-site}/api/strava/callback.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# 16+ character secret used to encrypt tokens. Can reuse WHOOP_TOKEN_SECRET.
STRAVA_TOKEN_SECRET=
# Optional override for the redirect URI. Leave blank to use the request origin.
STRAVA_REDIRECT_URI=
